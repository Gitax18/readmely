{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSettings",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": [
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/readmely/prod",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/readmely/prod/*"
      ]
    },
    {
      "Sid": "DecryptSettings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.<REGION>.amazonaws.com" } }
    },
    {
      "Sid": "ReadReleases",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<OPS_BUCKET>/releases/*"
    },
    {
      "Sid": "WriteAndRestoreBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<OPS_BUCKET>/backups/*"
    },
    {
      "Sid": "ListBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<OPS_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": "backups/*" } }
    }
  ]
}
