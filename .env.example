# Copy to .env and change every password. .env is git-ignored; never commit it.
# These values are for local development only.
#
# Passwords and tokens are inserted into connection URLs, so use only
# letters, digits, "-" and "_". Generate one with: openssl rand -hex 24

# Postgres (with pgvector)
POSTGRES_USER=readmely
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=readmely
# The services do not use the owner account above. They log in as these two limited roles
# (data changes only, never schema changes), whose passwords `make db-up` sets.
# At least 16 characters. Generate with: openssl rand -hex 24
APP_DB_PASSWORD=change-me-local-only
AI_DB_PASSWORD=change-me-local-only
# Host port. Change it if 5432 is already used on your machine.
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# Go API (host port for the container started by `make up-app`)
API_PORT=8080
# Signs sign-in codes and CSRF tokens. Required; at least 32 characters, letters, digits, - and _.
# Generate with: openssl rand -hex 32   (changing it ends every pending code and CSRF token)
AUTH_CODE_KEY=

# Email (sign-in codes and security alerts). Locally the default is MAILER=log: the code is
# written to the API's log and nothing is sent. To send real email through Brevo (free, 300 a day):
#   1. Brevo > SMTP & API > SMTP: copy the login, and generate an SMTP key (that is the password).
#   2. Brevo > Senders, domains > add your sender address (or authenticate your domain) so Brevo
#      will send from it. MAIL_FROM must be exactly that address.
#   3. Set MAILER=smtp and fill in the rest, then run: make up-app
# Any SMTP relay works the same way (Mailgun: smtp.mailgun.org). Production requires MAILER=smtp.
# Note: with MAILER=smtp the browser tests cannot read codes from the log, so leave it off for them.
MAILER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Readmely

# Sign in with Google / GitHub (optional; a provider with no credentials shows no button).
# Each pair is all or nothing. Register the redirect URI http://127.0.0.1:3000/api/v1/auth/google/callback
# (or .../github/callback) with the provider; GitHub needs its own OAuth App.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a read-only GitHub token (public data only, no scopes). It only raises the rate limit for
# looking up repositories (60 an hour without it); leave empty to use none.
GITHUB_API_TOKEN=

# Optional: lets people add their PRIVATE repositories. It seals the GitHub token each person grants
# (AES-256-GCM); generate with: openssl rand -hex 32. Empty switches private repositories off. Keep it
# safe and the same for the API and the analysis worker: a new key makes stored tokens unreadable, and
# people are asked to grant access again. Needs GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET above.
GITHUB_TOKEN_KEY=

# Web app (host port for the container started by `make up-app` and for `make run-web`)
WEB_PORT=3000
# full shows each dependency on the status page; coarse shows only overall state.
# Leave unset for the default: full when developing, coarse in production.
# STATUS_DETAIL=full

# Python AI service
# Shared secret the Go API sends to the AI service. At least 32 characters.
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=
# Host port for `make run-ai` (the container publishes no port)
AI_PORT=8000

# RustFS (S3-compatible object storage, local development only)
RUSTFS_ACCESS_KEY=readmely-local
RUSTFS_SECRET_KEY=change-me-local-only
# S3 API port and web console port
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Model provider for summaries and generated documents (optional: without a key, analysis still
# works and the summary step fails cleanly, refunding its credits).
OPENAI_API_KEY=
# Hard cap on what all model calls may cost per UTC day, in US dollars. Calls stop when it is reached.
LLM_DAILY_CAP_USD=3
# The model and its price per million tokens (USD). The cap is checked against these prices.
LLM_FAST_MODEL=gpt-4o-mini
LLM_FAST_INPUT_USD_PER_MTOK=0.15
LLM_FAST_OUTPUT_USD_PER_MTOK=0.60
